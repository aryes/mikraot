---
/**
 * Pages with content: the title area (PageBanner: a title card on inner pages, the photo on the
 * front page, whose title and tagline open the content card), then the content in one centred
 * column, narrow enough for comfortable lines (no sidebar since 2026-10-12: its archive and
 * category links are in the footer, "מה חדש" is linked under the front page's latest posts).
 * On phones (Arye, 2026-10-21) the card spans the screen, with the 16px side margin that Material
 * Design and Apple recommend: a card inside a margin left lines of ~310px.
 */
import PageBanner from '../components/layout/PageBanner.astro';
import { authorUrl } from '../lib/archive';
import { site, type Crumb } from '../lib/site';
import { jsonLd, structuredData } from '../lib/structured-data';
import type { Nusach } from '../lib/tropes';
import BaseLayout from './BaseLayout.astro';

interface Props {
  /** Document title (<title>). */
  documentTitle: string;
  description?: string | undefined;
  ogImage?: string | undefined;
  /** The page heading (the h1). */
  title: string;
  /** A trope page's trope: the heading names it in the reader's tradition, in place of `title`. */
  titleTrope?: string | undefined;
  /** The document title in each tradition, likewise. */
  documentTitles?: Record<Nusach, string> | undefined;
  /** The front page's tagline, under its title. */
  subtitle?: string | undefined;
  crumbs?: Crumb[] | undefined;
  noindex?: boolean | undefined;
  /** For posts: the article's date and category, for search engines. */
  post?: { date: Date; category?: string | undefined } | undefined;
}

const {
  documentTitle,
  description,
  ogImage,
  title,
  titleTrope,
  documentTitles,
  subtitle,
  crumbs,
  noindex,
  post,
} = Astro.props;
const origin = (Astro.site ?? Astro.url).origin;
const absolute = (path: string) => new URL(path, origin).href;
const structured = structuredData(
  {
    url: absolute(Astro.url.pathname),
    name: documentTitle,
    description,
    crumbs: (crumbs ?? []).map((crumb) => ({
      title: crumb.title,
      url: crumb.url && absolute(crumb.url),
    })),
    heading: title,
    isFrontPage: crumbs === undefined,
    post: post && { datePublished: post.date, section: post.category },
  },
  {
    origin,
    title: site.title,
    tagline: site.tagline,
    author: { name: site.author.name, url: absolute(authorUrl(site.author.slug)) },
  },
);
---

<BaseLayout
  title={documentTitle}
  titles={documentTitles}
  description={description}
  ogImage={ogImage}
  noindex={noindex}
>
  <script slot="head" type="application/ld+json" set:html={jsonLd(structured)} />
  <PageBanner title={title} titleTrope={titleTrope} crumbs={crumbs} />
  <div class="mx-auto max-w-4xl pb-3 sm:px-6 sm:py-8 lg:px-8 print:max-w-none print:p-0 print:pt-4">
    <div class="min-w-0 border-b border-slate-200/80 sm:rounded-2xl sm:border dark:border-slate-700/80 bg-white dark:bg-slate-900 px-4 py-6 shadow-xs sm:p-10 print:border-0 print:p-0 print:shadow-none">
      {crumbs === undefined && (
        <header class="mb-6 border-b-2 border-(--heading-rule) pb-4">
          <h1 class="text-[2.75rem] leading-none font-black tracking-tight text-brand-deep dark:text-brand-light sm:text-[3.75rem] print:text-black">
            {title}
          </h1>
          {subtitle && (
            <p class="mt-2 text-lg text-slate-600 dark:text-slate-300 sm:text-[1.3rem] print:text-slate-700">
              {subtitle}
            </p>
          )}
        </header>
      )}
      <slot />
      <!-- Printed copies say where they come from. -->
      <p class="mt-8 hidden border-t border-slate-300 pt-2 text-xs print:block">
        {site.title}: <bdi dir="ltr">{decodeURI(absolute(Astro.url.pathname))}</bdi>
      </p>
    </div>
  </div>
</BaseLayout>
