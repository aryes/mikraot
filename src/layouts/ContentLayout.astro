---
/**
 * Pages with content: the photo banner with the title, then the content card beside the sidebar
 * (below it on narrow screens).
 */
import PageBanner from '../components/layout/PageBanner.astro';
import Sidebar from '../components/layout/Sidebar.astro';
import type { Crumb } from '../lib/site';
import BaseLayout from './BaseLayout.astro';

interface Props {
  /** Document title (<title>). */
  documentTitle: string;
  description?: string | undefined;
  ogImage?: string | undefined;
  /** The page heading, shown in the banner. */
  title: string;
  subtitle?: string | undefined;
  crumbs?: Crumb[] | undefined;
  noindex?: boolean | undefined;
}

const { documentTitle, description, ogImage, title, subtitle, crumbs, noindex } = Astro.props;
---

<BaseLayout title={documentTitle} description={description} ogImage={ogImage} noindex={noindex}>
  <PageBanner title={title} subtitle={subtitle} crumbs={crumbs} />
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-8 sm:px-6 lg:grid-cols-[minmax(0,1fr)_18rem] lg:px-8">
    <div class="min-w-0 rounded-2xl border border-slate-200/80 bg-white p-6 shadow-xs sm:p-10">
      <slot />
    </div>
    <Sidebar />
  </div>
</BaseLayout>
