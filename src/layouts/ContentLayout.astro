---
/**
 * Pages with content: the photo banner with the title, then the content card beside the sidebar
 * (below it on narrow screens).
 */
import PageBanner from '../components/layout/PageBanner.astro';
import Sidebar from '../components/layout/Sidebar.astro';
import { authorUrl } from '../lib/archive';
import { site, type Crumb } from '../lib/site';
import { jsonLd, structuredData } from '../lib/structured-data';
import BaseLayout from './BaseLayout.astro';

interface Props {
  /** Document title (<title>). */
  documentTitle: string;
  description?: string | undefined;
  ogImage?: string | undefined;
  /** The page heading, shown in the banner. */
  title: string;
  subtitle?: string | undefined;
  crumbs?: Crumb[] | undefined;
  noindex?: boolean | undefined;
  /** For posts: the article's date and category, for search engines. */
  post?: { date: Date; category?: string | undefined } | undefined;
}

const { documentTitle, description, ogImage, title, subtitle, crumbs, noindex, post } = Astro.props;
const origin = (Astro.site ?? Astro.url).origin;
const absolute = (path: string) => new URL(path, origin).href;
const structured = structuredData(
  {
    url: absolute(Astro.url.pathname),
    name: documentTitle,
    description,
    crumbs: (crumbs ?? []).map((crumb) => ({ title: crumb.title, url: absolute(crumb.url) })),
    heading: title,
    isFrontPage: crumbs === undefined,
    post: post && { datePublished: post.date, section: post.category },
  },
  {
    origin,
    title: site.title,
    tagline: site.tagline,
    author: { name: site.author.name, url: absolute(authorUrl(site.author.slug)) },
  },
);
---

<BaseLayout title={documentTitle} description={description} ogImage={ogImage} noindex={noindex}>
  <script slot="head" type="application/ld+json" set:html={jsonLd(structured)} />
  <PageBanner title={title} subtitle={subtitle} crumbs={crumbs} />
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-8 sm:px-6 lg:grid-cols-[minmax(0,1fr)_18rem] lg:px-8 print:block print:max-w-none print:p-0 print:pt-4">
    <div class="min-w-0 rounded-2xl border border-slate-200/80 bg-white p-6 shadow-xs sm:p-10 print:border-0 print:p-0 print:shadow-none">
      <slot />
      <!-- Printed copies say where they come from. -->
      <p class="mt-8 hidden border-t border-slate-300 pt-2 text-xs print:block">
        {site.title}: <bdi dir="ltr">{decodeURI(absolute(Astro.url.pathname))}</bdi>
      </p>
    </div>
    <Sidebar />
  </div>
</BaseLayout>
