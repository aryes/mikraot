---
import '../styles/global.css';
import SearchDialog from '../components/SearchDialog.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../lib/site';

interface Props {
  /** Full document title, as the live site renders it (see src/data/seo.json). */
  title: string;
  description?: string | undefined;
  /** Site-relative image path for social previews. */
  ogImage?: string | undefined;
}

const { title, description, ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const icon = (size: number) =>
  `/wp-content/uploads/2021/08/cropped-pexels-cottonbro-5986498-scaled-1-${size}x${size}.jpg`;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href={icon(32)} sizes="32x32" />
    <link rel="icon" href={icon(192)} sizes="192x192" />
    <link rel="apple-touch-icon" href={icon(180)} />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content={`${site.title} - ${site.tagline}`} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <meta name="twitter:card" content="summary" />
  </head>
  <body
    id="top"
    class="flex min-h-screen flex-col bg-[#F3F7F5] font-sans text-[#444444] antialiased selection:bg-brand-strong selection:text-white"
  >
    <SiteHeader />
    <main class="flex-1">
      <slot />
    </main>
    <SiteFooter />
    <SearchDialog />
  </body>
</html>
