---
import '../styles/global.css';
import SearchDialog from '../components/SearchDialog.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../lib/site';
import { isGeneratedOgImage } from '../lib/og';

interface Props {
  /** Full document title, as the live site renders it (see src/data/seo.json). */
  title: string;
  description?: string | undefined;
  /** Site-relative image path for social previews. */
  ogImage?: string | undefined;
  /** Keep the page out of search engines (as the live site does for the author archive). */
  noindex?: boolean | undefined;
}

const { title, description, ogImage, noindex } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const icon = (size: number) =>
  `/wp-content/uploads/2021/08/cropped-pexels-cottonbro-5986498-scaled-1-${size}x${size}.jpg`;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.title} - פוסטים`}
      href="/feed/"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.title} - תגובות`}
      href="/comments/feed/"
    />
    <link rel="icon" href={icon(32)} sizes="32x32" />
    <link rel="icon" href={icon(192)} sizes="192x192" />
    <link rel="apple-touch-icon" href={icon(180)} />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content={`${site.title} - ${site.tagline}`} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    {ogImage && <meta property="og:image:alt" content={title} />}
    {
      // Declared size: without it Facebook often shows no picture the first time a page is shared.
      ogImage && isGeneratedOgImage(ogImage) && (
        <>
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <!-- A large preview when the page has a picture (pages get one generated: src/pages/og/). -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <slot name="head" />
  </head>
  <body
    id="top"
    class="flex min-h-screen flex-col bg-[#F3F7F5] font-sans text-[#444444] antialiased selection:bg-brand-strong selection:text-white print:bg-white print:text-black"
  >
    <!-- The first Tab stop: past the header and menu, straight to the page (hidden until focused;
         above the sticky header, z-50). -->
    <a
      href="#main"
      class="sr-only rounded-lg bg-brand-strong font-bold text-white focus:not-sr-only focus:fixed focus:top-3 focus:right-3 focus:z-[60] focus:px-4 focus:py-2"
    >
      דלג לתוכן
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <SiteFooter />
    <SearchDialog />
    <script src="../scripts/error-reporting.ts"></script>
    <script src="../scripts/legacy-links.ts"></script>
  </body>
</html>
