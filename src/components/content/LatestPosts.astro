---
/** The newest posts with date and a short excerpt (the WordPress "latest posts" block). */
import { getSitePages } from '../../lib/site';
import { excerptOf } from '../../lib/urls';

const EXCERPT_WORDS = 20;
const posts = (await getSitePages())
  .filter(({ entry }) => entry.data.kind === 'post')
  .toSorted((a, b) => b.entry.data.date.getTime() - a.entry.data.date.getTime());
const formatDate = (date: Date) => date.toLocaleDateString('en-GB', { timeZone: 'Asia/Jerusalem' }); // dd/mm/yyyy, as on WordPress
---

<ul class="latest-posts">
  {posts.map(({ entry, url }) => (
    <li>
      <a href={url} class="latest-posts-title">
        {entry.data.title}
      </a>
      <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
      <div class="latest-posts-excerpt">
        {entry.data.excerpt ?? excerptOf(entry.body ?? '', EXCERPT_WORDS)}
      </div>
    </li>
  ))}
</ul>
