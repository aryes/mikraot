---
/**
 * An explanation or solution hidden behind an eye toggle (the WordPress bg_collapse shortcode).
 * Inline collapses stay in the flow of the sentence; block ones wrap whole paragraphs.
 * Behaviour in src/scripts/content.ts.
 */
interface Props {
  expandText?: string;
  collapseText?: string;
  inline?: boolean;
}
const { expandText, collapseText, inline = false } = Astro.props;
const id = `collapse-${crypto.randomUUID().slice(0, 8)}`;
const Panel = inline ? 'span' : 'div';
---

<span class="bg-collapse-wrapper my-2 inline-block">
  <button
    type="button"
    class="collapse-toggle-btn inline-flex cursor-pointer items-center gap-1 rounded-lg border border-slate-200 bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700 transition-all hover:bg-emerald-50 hover:text-brand-strong"
    data-target={id}
    aria-expanded="false"
    aria-controls={id}
    aria-label={expandText ? undefined : 'הצג / הסתר ביאור'}
  >
    <svg
      class="h-3.5 w-3.5"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
      <circle cx="12" cy="12" r="3"></circle>
    </svg>
    {expandText && (
      <span
        class="collapse-label"
        data-expand-text={expandText}
        data-collapse-text={collapseText || expandText}
      >
        {expandText}
      </span>
    )}
  </button>
</span>
<Panel
  id={id}
  class:list={[
    'collapse-target hidden rounded-l-lg border-r-3 border-brand bg-emerald-50/60 text-sm leading-relaxed text-slate-800',
    inline ? 'mx-1 px-2 py-0.5' : 'mt-2 block p-3',
  ]}
>
  <slot />
</Panel>
