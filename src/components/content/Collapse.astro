---
/**
 * An explanation or solution hidden behind a toggle (the WordPress bg_collapse shortcode).
 * Inline collapses stay in the flow of the sentence; block ones wrap whole paragraphs.
 * Behaviour in src/scripts/content.ts.
 *
 * The button says what it does, "פתרון" with an eye (and "הסתר" once open), 32 px tall with a
 * 44 px tap area (the review, Arye 2026-10-20). Screen readers also hear which word it answers
 * ("פתרון ל־יָֽהְצָה"): content.ts copies the text before it into the hidden `.collapse-for`.
 * Open and closed looks follow aria-expanded, so the script only flips that.
 */
interface Props {
  expandText?: string;
  collapseText?: string;
  inline?: boolean;
}
const { inline = false } = Astro.props;
// Empty texts too (the editor saves "" for a cleared field).
const expandText = Astro.props.expandText || 'פתרון';
const collapseText = Astro.props.collapseText || 'הסתר';
const id = `collapse-${crypto.randomUUID().slice(0, 8)}`;
const Panel = inline ? 'span' : 'div';
const eye = 'M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z';
---

<span class="bg-collapse-wrapper my-2 ms-3 inline-block align-middle">
  <button
    type="button"
    class="collapse-toggle-btn group relative inline-flex h-8 cursor-pointer items-center gap-1.5 rounded-lg border border-brand-strong bg-white px-3 align-middle text-sm leading-none font-semibold text-brand-strong transition-colors duration-150 before:absolute before:-inset-1.5 before:content-[''] hover:bg-emerald-50 aria-expanded:bg-brand-strong aria-expanded:text-white aria-expanded:hover:bg-brand-deep dark:border-brand dark:bg-slate-900 dark:text-brand dark:hover:bg-emerald-950 dark:aria-expanded:bg-brand-strong dark:aria-expanded:text-white dark:aria-expanded:hover:bg-brand-deep"
    data-target={id}
    aria-expanded="false"
    aria-controls={id}
  >
    <svg
      class="h-4 w-4 shrink-0 group-aria-expanded:hidden"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d={eye}></path>
      <circle cx="12" cy="12" r="3"></circle>
    </svg>
    <svg
      class="hidden h-4 w-4 shrink-0 group-aria-expanded:block"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d={eye}></path>
      <path d="M3 3l18 18"></path>
    </svg>
    <span class="collapse-label" data-expand-text={expandText} data-collapse-text={collapseText}>
      {expandText}
    </span>
    <span class="collapse-for sr-only group-aria-expanded:hidden"></span>
  </button>
</span>
<Panel
  id={id}
  class:list={[
    'collapse-target hidden rounded-l-lg border-r-3 border-brand bg-emerald-50/60 dark:bg-emerald-950/40 text-[0.9em] leading-relaxed text-slate-800 dark:text-slate-100',
    inline ? 'mx-1 box-decoration-clone px-2 py-0.5' : 'mt-2 block p-3',
  ]}
>
  <slot />
</Panel>
