---
/**
 * The content tag `{% trope name="טפחא" /%}`: a trope's name in the reader's tradition
 * (NusachText; names in src/data/tropes.json, without the table's bracketed alternatives). With
 * `nusach`, one tradition's full name as the names table gives it (the trope pages' names tables,
 * the trope list). With `link`, a link to the trope's page.
 */
import { shortName, switchNames, trope, type Tradition } from '../../lib/tropes';
import NusachText from './NusachText.astro';

interface Props {
  name: string;
  nusach?: Tradition | '';
  link?: boolean;
}

const { name, nusach, link } = Astro.props;
const names = trope(name);
const fixed = nusach ? names[nusach] || '—' : undefined;
// Encoded like the content's other links (the trope list's CSS matches the encoded address).
const href = link ? encodeURI(names.href) : undefined;
// One line: whitespace inside <a> would add visible spaces.
---

<!-- prettier-ignore -->
{href ? <a href={href}>{fixed ?? <NusachText names={switchNames(name, shortName)} />}</a> : fixed ?? <NusachText names={switchNames(name, shortName)} />}
