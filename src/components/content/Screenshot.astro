---
/**
 * The content tag `{% screenshot light="x.png" dark="x-dark.png" alt="…" /%}`: a picture from
 * src/assets/posts/, with a dark-mode version shown in dark mode (screens only: print stays light,
 * like the rest of the site; turned on by the inline script, src/lib/theme-head.mjs). Converted to
 * WebP at build time, size set.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { DEVICE_DARK } from '../../lib/theme';
import { THEME_PICTURE_SCRIPT } from '../../lib/theme-head.mjs';

interface Props {
  light: string;
  dark?: string | undefined;
  alt: string;
}

const { light, dark, alt } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/posts/*.{png,jpg,jpeg,webp}',
  {
    eager: true,
  },
);
const load = (name: string) => {
  const file = files[`/src/assets/posts/${name}`];
  if (!file) throw new Error(`No picture "${name}" in src/assets/posts/`);
  return getImage({ src: file.default, format: 'webp' });
};
const lightImage = await load(light);
const darkImage = dark ? await load(dark) : undefined;
---

<picture class="content-picture">
  {darkImage && <source media={DEVICE_DARK} data-dark srcset={darkImage.src} type="image/webp" />}
  {darkImage && <script is:inline set:html={THEME_PICTURE_SCRIPT} />}
  <img
    src={lightImage.src}
    alt={alt}
    width={lightImage.attributes.width}
    height={lightImage.attributes.height}
    loading="lazy"
    decoding="async"
  />
</picture>
