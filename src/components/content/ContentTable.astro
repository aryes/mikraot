---
/**
 * Tables scroll sideways on their own when wider than the screen, instead of widening the page.
 * The scroll area is focusable so keyboard users can scroll it too, and a named region so screen
 * readers announce it; tables are numbered per page because landmark names must be unique.
 * Each cell ends with a space: the search index (Pagefind) joins adjacent cells' text, so without
 * it a row read as one word ("תנועה גדולהתנועה קטנה"); a space at a cell's end doesn't show.
 */
Astro.locals.tableCount = (Astro.locals.tableCount ?? 0) + 1;
// Read before the await below: other tables on the page count up meanwhile.
const number = Astro.locals.tableCount;
const rows = (await Astro.slots.render('default')).replace(/<\/(td|th)>/g, ' </$1>');
---

<section class="table-scroll" tabindex="0" aria-label={`טבלה ${number}`}>
  <table>
    <Fragment set:html={rows} />
  </table>
</section>
