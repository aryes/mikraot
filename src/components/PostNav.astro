---
/** Under a post: previous/next post and related posts (same category), as on the WordPress site. */
import { adjacentPosts, relatedPosts, type NavPost } from '../lib/post-nav';
import { getPosts, type SitePage } from '../lib/site';
import Pointed from './Pointed.astro';

interface Props {
  page: SitePage;
}

const toNav = ({ url, entry }: SitePage): NavPost => ({
  url,
  title: entry.data.title,
  date: entry.data.date,
  categories: entry.data.categories,
});
const posts = (await getPosts()).map(toNav);
const current = toNav(Astro.props.page);
const { previous, next } = adjacentPosts(posts, current.url);
const related = relatedPosts(posts, current);
const link =
  'text-brand-strong dark:text-brand hover:text-brand-deep dark:hover:text-brand-light hover:underline';
---

{related.length > 0 && (
  <section
    class="mt-10 border-t border-slate-100 dark:border-slate-800 pt-6"
    aria-labelledby="related-posts"
  >
    <h2
      id="related-posts"
      class="font-hebrew mb-3 text-lg font-bold text-slate-800 dark:text-slate-100"
    >
      פוסטים קשורים
    </h2>
    <ul class="space-y-1.5">
      {related.map((post) => (
        <li>
          <a href={post.url} class={link}>
            <Pointed text={post.title} />
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
{(previous || next) && (
  <nav
    class="mt-8 flex flex-wrap justify-between gap-4 border-t border-slate-100 dark:border-slate-800 pt-6 text-sm"
    aria-label="ניווט בין פוסטים"
  >
    {previous ? (
      <a href={previous.url} rel="prev" class={link}>
        → הפוסט הקודם: <Pointed text={previous.title} />
      </a>
    ) : (
      <span />
    )}
    {next && (
      <a href={next.url} rel="next" class={link}>
        הפוסט הבא: <Pointed text={next.title} /> ←
      </a>
    )}
  </nav>
)}
