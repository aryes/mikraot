---
/** The sidebar of the live site: post archives by month and the categories. */
import { archiveMonths, categoryUrl } from '../../lib/archive';
import { getPosts, site } from '../../lib/site';

const posts = await getPosts();
const months = archiveMonths(posts.map(({ entry }) => entry.data.date));
const used = new Set(posts.flatMap(({ entry }) => entry.data.categories));
const categories = site.categories.filter((c) => used.has(c.slug));
const box = 'rounded-2xl border border-slate-200/80 bg-white p-5 shadow-xs';
const heading = 'font-hebrew mb-3 text-lg font-bold text-slate-800';
const link = 'text-brand-strong hover:text-brand-deep hover:underline';
---

<aside aria-label="סרגל צד" class="space-y-6">
  {months.length > 0 && (
    <section class={box} aria-labelledby="sidebar-archives">
      <h2 id="sidebar-archives" class={heading}>
        ארכיון
      </h2>
      <ul class="space-y-1.5">
        {months.map((m) => (
          <li>
            <a href={m.url} class={link}>
              {m.label}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
  {categories.length > 0 && (
    <section class={box} aria-labelledby="sidebar-categories">
      <h2 id="sidebar-categories" class={heading}>
        קטגוריות
      </h2>
      <ul class="space-y-1.5">
        {categories.map((c) => (
          <li>
            <a href={categoryUrl(c.slug)} class={link}>
              {c.name}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</aside>
