---
/**
 * The photo banner at the top of every page, as on the live site: the page title over the
 * cottonbro photo, with the breadcrumb trail (or, on the front page, the site's tagline).
 */
import type { Crumb } from '../../lib/site';

interface Props {
  title: string;
  /** Under the title instead of a breadcrumb trail (the front page). */
  subtitle?: string | undefined;
  /** Pages above this one; the trail starts at the home page and ends with the title. */
  crumbs?: Crumb[] | undefined;
}

const { title, subtitle, crumbs } = Astro.props;
const photo = (size: string) => `/wp-content/uploads/2021/08/pexels-cottonbro-5986498-${size}.jpg`;
---

<div class="relative isolate overflow-hidden bg-slate-700">
  <img
    src={photo('1536x1024')}
    srcset={`${photo('768x512')} 768w, ${photo('1024x683')} 1024w, ${photo('1536x1024')} 1536w, ${photo('2048x1365')} 2048w`}
    sizes="100vw"
    alt=""
    fetchpriority="high"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <div class="mx-auto flex min-h-40 max-w-7xl items-center px-4 py-8 sm:min-h-[250px] sm:px-6 lg:px-8">
    <div class="w-full rounded-lg bg-slate-900/65 px-6 py-5 text-white">
      <h1 class="font-hebrew text-3xl leading-tight font-extrabold tracking-tight sm:text-4xl">
        {title}
      </h1>
      {subtitle && <p class="mt-2 text-lg text-slate-100">{subtitle}</p>}
      {crumbs && (
        <nav aria-label="פירורי לחם" class="mt-3 text-sm text-slate-100">
          <ol class="flex flex-wrap items-center gap-2">
            <li>
              <a href="/" class="underline-offset-2 hover:underline">
                ראשי
              </a>
            </li>
            {crumbs.map((crumb) => (
              <li class="flex items-center gap-2">
                <span aria-hidden="true">/</span>
                <a href={crumb.url} class="underline-offset-2 hover:underline">
                  {crumb.title}
                </a>
              </li>
            ))}
            <li class="flex items-center gap-2">
              <span aria-hidden="true">/</span>
              <span aria-current="page" class="font-semibold">
                {title}
              </span>
            </li>
          </ol>
        </nav>
      )}
    </div>
  </div>
</div>
