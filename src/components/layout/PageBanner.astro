---
/**
 * The title area at the top of every page. Inner pages get a compact card (designed with Arye,
 * 2026-10-09): the breadcrumb trail on top, then a small crop of the photo, around the yad's tip,
 * beside the title. The front page keeps the live site's wide photo, now without the shaded box
 * over it; its title and tagline open the content card instead (ContentLayout.astro). The photo is
 * zoomed (1.2x, 1.6x on phones) toward its upper right, so the yad fills the strip and its handle
 * leaves just below the top corner instead of leaving an empty area (Arye, 2026-10-12). On phones
 * (Arye, 2026-10-21) the card spans the screen and leaves out the photo crop and some padding, so
 * the first screen shows the content rather than the title.
 */
import type { Crumb } from '../../lib/site';
import TropeName from '../content/TropeName.astro';

interface Props {
  title: string;
  /** A trope page's trope: the title names it in the reader's tradition, in place of `title`. */
  titleTrope?: string | undefined;
  /** Pages above this one; the trail starts at the home page and ends with the title. */
  crumbs?: Crumb[] | undefined;
}

const { title, titleTrope, crumbs } = Astro.props;
import { Picture } from 'astro:assets';
// The WordPress banner photo (also kept at its old URLs in public/wp-content/uploads/), resized
// and converted to AVIF/WebP at build time; the banner shows only a strip of it.
import banner from '../../assets/banner-cottonbro.jpg';
// The same photo cropped around the yad's tip (aspect 1.9), shown 120 px wide.
import bannerYad from '../../assets/banner-yad.jpg';
---

{crumbs ? (
  <div class="mx-auto max-w-4xl sm:px-6 sm:pt-6 lg:px-8 print:max-w-none print:p-0">
    <div class="border-b border-slate-200/80 sm:rounded-2xl sm:border dark:border-slate-700/80 bg-white dark:bg-slate-900 px-4 py-3 shadow-xs sm:px-5 print:border-0 print:p-0 print:shadow-none">
      <nav
        aria-label="פירורי לחם"
        class="mb-1 text-sm sm:mb-2 text-brand-strong dark:text-brand print:hidden"
      >
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a href="/" class="inline-block py-1 underline-offset-2 hover:underline">
              ראשי
            </a>
          </li>
          {crumbs.map((crumb) => (
            <li class="flex items-center gap-2">
              <span aria-hidden="true">/</span>
              {crumb.url ? (
                <a href={crumb.url} class="inline-block py-1 underline-offset-2 hover:underline">
                  {crumb.title}
                </a>
              ) : (
                // Grey, unlike the links: a menu section with no page of its own.
                <span class="inline-block py-1 text-slate-600 dark:text-slate-400">
                  {crumb.title}
                </span>
              )}
            </li>
          ))}
          <li class="flex items-center gap-2">
            <span aria-hidden="true">/</span>
            <span aria-current="page" class="font-semibold text-brand-deep dark:text-brand-light">
              {titleTrope ? <TropeName name={titleTrope} /> : title}
            </span>
          </li>
        </ol>
      </nav>
      <div class="flex items-center sm:gap-5">
        <Picture
          src={bannerYad}
          formats={['avif', 'webp']}
          widths={[120, 240]}
          sizes="120px"
          alt=""
          loading="eager"
          class="banner-photo hidden h-16 w-[120px] flex-none rounded-lg object-cover sm:block print:hidden"
        />
        <h1 class="text-[1.75rem] leading-tight font-bold text-brand-deep dark:text-brand-light sm:text-4xl print:text-black">
          {titleTrope ? <TropeName name={titleTrope} /> : title}
        </h1>
      </div>
    </div>
  </div>
) : (
  <div class="relative isolate overflow-hidden bg-slate-700 print:bg-transparent">
    <Picture
      src={banner}
      formats={['avif', 'webp']}
      widths={[768, 1024, 1536, 2048]}
      sizes="(min-width: 640px) 120vw, 160vw"
      alt=""
      fetchpriority="high"
      loading="eager"
      class="banner-photo absolute inset-0 -z-10 h-full w-full origin-[45%_10%] scale-160 object-cover sm:scale-120 print:hidden"
    />
    <div class="min-h-40 sm:min-h-[250px] print:hidden"></div>
  </div>
)}
