---
import { ArrowUp } from 'lucide-react';
import { NewsletterSignup } from './NewsletterSignup';
import YadMark from './YadMark.astro';
import { archiveMonths, categoryUrl } from '../lib/archive';
import { getPosts, getSitePages, menuTree, pointedTitle, site, WHATS_NEW_URL } from '../lib/site';

// Top-level menu items that have a page (groups such as הגיה only open a dropdown in the header).
const quickLinks = menuTree.filter(
  (item): item is (typeof menuTree)[number] & { url: string } => item.url !== null,
);
// The post archives (by month) and categories, as in the live site's sidebar.
const posts = await getPosts();
const months = archiveMonths(posts.map(({ entry }) => entry.data.date));
const used = new Set(posts.flatMap(({ entry }) => entry.data.categories));
const categories = site.categories.filter((c) => used.has(c.slug));
// The bottom line, as sites usually have it (2026-10-12): © with the years the site has existed,
// and the legal and about pages. No second slogan: the tagline is the header's.
const thisYear = new Date().getFullYear(); // the build's year: updated by the next deploy
// The first post's year (the site went up with it); just this year if there are none.
const firstYear = Math.min(thisYear, ...posts.map(({ entry }) => entry.data.date.getFullYear()));
const years = firstYear < thisYear ? `${firstYear}–${thisYear}` : String(thisYear);
const pageUrl = new Map((await getSitePages()).map(({ entry, url }) => [entry.id, url]));
const legalLinks = [
  { title: 'מדיניות הפרטיות', url: pageUrl.get('privacy-policy') },
  { title: 'אודות', url: pageUrl.get('about') },
].filter((link): link is { title: string; url: string } => link.url !== undefined);
const footerHeading = 'mb-3 border-b border-slate-700 pb-2 text-base font-bold text-white';
// Taller tap areas on phones (about 24 px; the design review, 2026-10-12), same look.
const footerLink = 'inline-block py-1 transition-colors hover:text-brand';
---

<footer class="print:hidden mt-20 border-t border-slate-800 bg-[#1E2C35] text-slate-300">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-3 md:grid-cols-5">
      <div class="space-y-3 sm:col-span-3 md:col-span-2">
        <div class="flex items-center gap-2 text-white">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-strong text-white">
            <YadMark gap="#5b763e" class="h-7 w-7" />
          </div>
          <span class="font-logo text-2xl">
            <span aria-hidden="true">{pointedTitle}</span>
            <span class="sr-only">{site.title}</span>
          </span>
        </div>
        <p class="max-w-md text-base leading-relaxed text-slate-300">
          אתר מוקדש ללימוד, שיפור והעמקת הקריאה בתנ״ך, כולל דיוקי הגיה, כללי דקדוק, טעמי המקרא
          וקריאות מוקלטות בנוסחים השונים.
        </p>
        <div class="max-w-md pt-4">
          <NewsletterSignup client:visible headingClass={footerHeading} />
        </div>
      </div>

      <nav aria-labelledby="footer-nav">
        <h2 id="footer-nav" class={footerHeading}>
          ניווט מהיר
        </h2>
        <ul class="space-y-2 text-base">
          <li>
            <a href="/" class={footerLink}>
              דף הבית
            </a>
          </li>
          {quickLinks.map((item) => (
            <li>
              <a href={item.url} class={footerLink}>
                {item.title}
              </a>
            </li>
          ))}
          <li>
            <a href={WHATS_NEW_URL} class={footerLink}>
              מה חדש
            </a>
          </li>
        </ul>
      </nav>
      {months.length > 0 && (
        <nav aria-labelledby="footer-archives">
          <h2 id="footer-archives" class={footerHeading}>
            ארכיון
          </h2>
          <ul class="space-y-2 text-base">
            {months.map((m) => (
              <li>
                <a href={m.url} class={footerLink}>
                  {m.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      {categories.length > 0 && (
        <nav aria-labelledby="footer-categories">
          <h2 id="footer-categories" class={footerHeading}>
            קטגוריות
          </h2>
          <ul class="space-y-2 text-base">
            {categories.map((c) => (
              <li>
                <a href={categoryUrl(c.slug)} class={footerLink}>
                  {c.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-slate-800/80 pt-6 text-sm text-slate-300 sm:flex-row">
      {/* Each item with the dot before it, so a line never ends in a dot (phones). */}
      <p class="text-center sm:text-start">
        <span class="whitespace-nowrap">
          © {years} {site.copyright}
        </span>
        {/* The content licence (Arye, 2026-10-20): teachers may copy and adapt the lessons, with
            credit, not for sale, and share alike. Creative Commons has no Hebrew page for it. */}
        <span class="whitespace-nowrap">
          <span aria-hidden="true" class="mx-2">
            ·
          </span>
          <a
            href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
            rel="license noopener"
            target="_blank"
            class={footerLink}
          >
            התוכן ברישיון CC BY-NC-SA 4.0
          </a>
        </span>
        {legalLinks.map((link) => (
          <span class="whitespace-nowrap">
            <span aria-hidden="true" class="mx-2">
              ·
            </span>
            <a href={link.url} class={footerLink}>
              {link.title}
            </a>
          </span>
        ))}
      </p>
      <a
        href="#top"
        class="flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-800 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-all hover:bg-slate-700"
      >
        <ArrowUp size={14} /> לראש העמוד
      </a>
    </div>
  </div>
</footer>
