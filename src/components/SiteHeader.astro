---
import { BookOpen, ChevronDown, Home, Menu, Search } from 'lucide-react';
import { menuTree, site } from '../lib/site';

const current = decodeURI(Astro.url.pathname);
const isActive = (url: string | null) => url !== null && url === current;
const navLink = 'flex items-center gap-1 rounded-lg px-3 py-2 transition-colors';
const activeLink = 'bg-white font-bold text-brand-strong shadow-xs';
const idleLink = 'hover:bg-white/60 hover:text-brand-strong';
const hasChildren = (item: { children?: unknown[] | undefined }) =>
  item.children !== undefined && item.children.length > 0;
import Pointed from './Pointed.astro';
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white shadow-xs">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="group flex items-center gap-3 select-none">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-tr from-brand-strong to-brand text-white shadow-sm transition-transform group-hover:scale-105">
        <BookOpen size={22} />
      </div>
      <div>
        <p class="text-2xl leading-none font-black tracking-tight text-slate-800 transition-colors group-hover:text-brand-strong">
          {site.title}
        </p>
        <p class="mt-0.5 text-xs font-medium text-slate-500">{site.tagline}</p>
      </div>
    </a>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-open-search
        class="flex cursor-pointer items-center gap-2 rounded-xl bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-600 transition-colors hover:bg-slate-200/80"
        aria-label="חיפוש באתר"
      >
        <Search size={15} />
        <span class="hidden sm:inline">חיפוש...</span>
        <kbd class="hidden rounded border border-slate-300 bg-white px-1.5 py-0.5 text-[10px] text-slate-600 md:inline">
          Ctrl+K
        </kbd>
      </button>

      <!-- Mobile menu: a native disclosure, so it works without JavaScript. -->
      <details class="md:hidden">
        <summary
          class="list-none rounded-lg p-2 text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 [&::-webkit-details-marker]:hidden"
          aria-label="תפריט"
        >
          <Menu size={22} />
        </summary>
        <nav
          class="absolute inset-x-0 top-full max-h-[80vh] space-y-2 overflow-y-auto border-b border-slate-200 bg-white px-4 pt-2 pb-6 shadow-md"
          aria-label="תפריט"
        >
          <a
            href="/"
            class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-bold text-slate-800 hover:bg-slate-50"
          >
            <Home size={16} /> ראשי
          </a>
          {menuTree.map((item) => (
            <div class="space-y-1">
              <a
                href={item.url ?? undefined}
                class="block rounded-lg px-3 py-2 text-sm font-bold text-slate-800 hover:bg-slate-50"
              >
                <Pointed text={item.title} />
              </a>
              {hasChildren(item) && (
                <div class="mr-4 space-y-1 border-r-2 border-slate-200 pr-3">
                  {item.children?.map((sub) => (
                    <div>
                      <a
                        href={sub.url ?? undefined}
                        class="block rounded-lg px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50 hover:text-brand-strong"
                      >
                        <Pointed text={sub.title} />
                      </a>
                      {hasChildren(sub) && (
                        <div class="mr-3 space-y-0.5 border-r border-slate-200 pr-2">
                          {sub.children?.map((subSub) => (
                            <a
                              href={subSub.url ?? undefined}
                              class="block px-2 py-1 text-[11px] text-slate-500 hover:text-brand-strong"
                            >
                              <Pointed text={subSub.title} />
                            </a>
                          ))}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))}
        </nav>
      </details>
    </div>
  </div>

  <!-- Desktop menu: dropdowns open on hover and keyboard focus via CSS only. -->
  <nav class="hidden border-t border-slate-200/60 bg-slate-50 md:block" aria-label="ניווט ראשי">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ul class="flex items-center gap-1 py-1 text-sm font-semibold text-slate-700">
        <li>
          <a href="/" class:list={[navLink, isActive('/') ? activeLink : idleLink]}>
            <Home size={15} /> ראשי
          </a>
        </li>
        {menuTree.map((item) => {
          const url = item.url;
          // Items without a URL only open a dropdown; a button keeps them keyboard-focusable.
          const Trigger = url ? 'a' : 'button';
          return (
            <li class="group relative">
              <Trigger
                href={url ?? undefined}
                type={url ? undefined : 'button'}
                aria-haspopup={hasChildren(item) ? 'true' : undefined}
                class:list={[navLink, isActive(url) ? activeLink : idleLink]}
              >
                <Pointed text={item.title} />
                {hasChildren(item) && (
                  <ChevronDown
                    size={14}
                    className="text-slate-400 transition-transform group-hover:rotate-180"
                  />
                )}
              </Trigger>
              {hasChildren(item) && (
                <div class="invisible absolute top-full right-0 z-50 min-w-[220px] -translate-y-1 rounded-xl border border-slate-200 bg-white py-2 opacity-0 shadow-lg transition-all duration-150 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                  {item.children?.map((sub) => (
                    <div class="group/sub relative">
                      <a
                        href={sub.url ?? undefined}
                        class="flex w-full items-center justify-between px-4 py-2 text-right text-xs font-medium text-slate-700 transition-colors hover:bg-slate-50 hover:text-brand-strong"
                      >
                        <span>
                          <Pointed text={sub.title} />
                        </span>
                        {hasChildren(sub) && (
                          <ChevronDown size={12} className="-rotate-90 text-slate-400" />
                        )}
                      </a>
                      {hasChildren(sub) && (
                        <div class="absolute top-0 right-full mr-1 hidden min-w-[200px] rounded-xl border border-slate-200 bg-white py-2 shadow-lg group-focus-within/sub:block group-hover/sub:block">
                          {sub.children?.map((subSub) => (
                            <a
                              href={subSub.url ?? undefined}
                              class="block w-full px-4 py-2 text-right text-xs font-medium text-slate-700 transition-colors hover:bg-slate-50 hover:text-brand-strong"
                            >
                              <Pointed text={subSub.title} />
                            </a>
                          ))}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </nav>
</header>
