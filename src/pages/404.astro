---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="העמוד לא נמצא – מקראות">
  <div class="mx-auto max-w-3xl px-4 py-20 text-center">
    <h1 class="mb-3 text-3xl font-bold text-slate-800">העמוד לא נמצא (404)</h1>
    <p class="mb-6 text-slate-600">העמוד המבוקש אינו קיים או שהועבר.</p>
    <a
      href="/"
      class="inline-block rounded-xl bg-brand-strong print:hidden px-6 py-2.5 font-bold text-white shadow-xs transition-all hover:bg-brand-deep"
    >
      חזרה לדף הבית
    </a>
  </div>
</BaseLayout>
