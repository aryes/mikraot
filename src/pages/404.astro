---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="העמוד לא נמצא – מקראות">
  <div class="mx-auto max-w-3xl px-4 py-20 text-center">
    <h1 class="mb-3 text-3xl font-bold text-slate-800 dark:text-slate-100">העמוד לא נמצא (404)</h1>
    <p class="mb-6 text-slate-600 dark:text-slate-300">העמוד המבוקש אינו קיים או שהועבר.</p>
    <a
      href="/"
      class="inline-block rounded-xl bg-brand-strong print:hidden px-6 py-2.5 font-bold text-white shadow-xs transition-all hover:bg-brand-deep"
    >
      חזרה לדף הבית
    </a>
  </div>
  <script>
    import { track } from '../scripts/analytics';
    // Which missing addresses visitors reach (broken links elsewhere, old WordPress URLs): each
    // Umami event carries the page's address (without its query), so no property is needed.
    track('page-not-found');
  </script>
</BaseLayout>
