---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Comments } from '../components/Comments';
import PostMeta from '../components/PostMeta.astro';
import PostNav from '../components/PostNav.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
import { ogImagePath } from '../lib/og';
import { categoryUrl, formatDate } from '../lib/archive';
import { lastChanged } from '../lib/last-changed';
import {
  categoryName,
  commentKey,
  commentKeys,
  getSitePages,
  parentCrumbs,
  site,
  type SitePage,
} from '../lib/site';

export const getStaticPaths = (async () => {
  const pages = await getSitePages();
  return pages.map((page) => ({
    params: { path: page.path || undefined },
    props: { page, pages },
  }));
}) satisfies GetStaticPaths;

interface Props {
  page: SitePage;
  pages: SitePage[];
}

const { page, pages } = Astro.props;
const { entry, path } = page;
const { title, seo, kind, categories } = entry.data;
const { Content } = await render(entry);
const lastUpdated =
  entry.data.showLastUpdated && entry.filePath ? lastChanged(entry.filePath) : undefined;
const isFrontPage = path === '';
const isPost = kind === 'post';
// A post's trail runs through its category, as on WordPress; a page's through its parents.
const crumbs = isPost
  ? categories.map((slug) => ({ title: categoryName(slug), url: categoryUrl(slug) })).slice(0, 1)
  : parentCrumbs(page, pages);
---

<ContentLayout
  documentTitle={seo?.title || `${title} - ${site.title}`}
  description={seo?.description || undefined}
  ogImage={seo?.ogImage || ogImagePath(path)}
  title={isFrontPage ? site.title : title}
  subtitle={isFrontPage ? site.tagline : undefined}
  crumbs={isFrontPage ? undefined : crumbs}
  post={
    isPost
      ? { date: entry.data.date, category: categories[0] && categoryName(categories[0]) }
      : undefined
  }
>
  {isPost && <PostMeta entry={entry} />}

  <!-- data-pagefind-body: only page content is indexed for search (not header, footer, comments). -->
  <div
    data-pagefind-body
    data-pagefind-meta={`title:${title}`}
    class="wp-content-rendered prose prose-slate max-w-none text-right"
  >
    {lastUpdated && (
      <p>
        עודכן לאחרונה: <time datetime={lastUpdated.toISOString()}>{formatDate(lastUpdated)}</time>
      </p>
    )}
    <Content />
  </div>

  {isPost && (
    <div class="print:hidden">
      <PostNav page={page} />
    </div>
  )}

  <div data-pagefind-ignore class="print:hidden">
    <Comments client:visible pageKey={commentKey(page)} lookupKeys={commentKeys(page)} />
  </div>
</ContentLayout>

<script src="../scripts/content.ts"></script>
