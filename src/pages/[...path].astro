---
import type { GetStaticPaths } from 'astro';
import { Comments } from '../components/Comments';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePages, urlForId, type SitePage } from '../lib/site';
import { wpHtmlToSiteHtml } from '../lib/wp-html';

export const getStaticPaths = (() =>
  sitePages.map((page) => ({
    params: { path: page.path || undefined },
    props: { page },
  }))) satisfies GetStaticPaths;

interface Props {
  page: SitePage;
}

const { item, path, seo } = Astro.props.page;
const commentKeys = [...new Set([path, item.slug, item.rawSlug, String(item.id)].filter(Boolean))];
const isFrontPage = path === '';
---

<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage}>
  <!-- data-pagefind-body: only page content is indexed for search (not header, footer, comments). -->
  <article data-pagefind-body class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
    {!isFrontPage && (
      <nav
        class="mb-6 flex items-center gap-2 text-xs font-medium text-slate-500"
        aria-label="פירורי לחם"
      >
        <a href="/" class="hover:text-[#8CB65F]">
          ראשי
        </a>
        <span>/</span>
        <span class="max-w-xs truncate font-semibold text-slate-800">{item.title}</span>
      </nav>
    )}

    <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-xs sm:p-10">
      <header class="mb-8 border-b border-slate-100 pb-6">
        <h1
          data-pagefind-meta="title"
          class="font-hebrew mb-2 text-3xl leading-tight font-extrabold tracking-tight text-[#334155] sm:text-4xl"
        >
          {item.title}
        </h1>
      </header>

      <div
        class="wp-content-rendered prose prose-slate max-w-none text-right"
        set:html={wpHtmlToSiteHtml(item.content, urlForId)}
      />

      <div data-pagefind-ignore>
        <Comments client:visible pageKey={path || String(item.id)} lookupKeys={commentKeys} />
      </div>
    </div>
  </article>
</BaseLayout>

<script src="../scripts/content.ts"></script>
