---
/**
 * Unsubscribes from the newsletter, from the link in the welcome email (src/server/newsletter.ts).
 * It asks for one click: a link alone would be followed by mail scanners that open every link.
 * Mail apps' own one-click unsubscribe (a POST from elsewhere) is handled in src/worker.ts.
 */
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { emailFromToken, unsubscribeNewsletter } from '../../server/newsletter';

// Runs in the Worker on each request.
export const prerender = false;

const token = Astro.url.searchParams.get('token') ?? '';
const signingKey = env.NEWSLETTER_WEBHOOK_SECRET;
let state: 'ask' | 'done' | 'unknown' =
  token && (await emailFromToken(signingKey ?? '', token)) ? 'ask' : 'unknown';
if (Astro.request.method === 'POST' && state === 'ask') {
  await unsubscribeNewsletter({ apiKey: env.BREVO_API_KEY, secret: signingKey, token });
  state = 'done';
}
---

<BaseLayout title="ביטול ההרשמה לעדכונים – מקראות" noindex>
  <div class="mx-auto max-w-3xl px-4 py-20 text-center">
    <h1 class="mb-3 text-3xl font-bold text-slate-800 dark:text-slate-100">
      ביטול ההרשמה לעדכונים
    </h1>
    {state === 'ask' && (
      <form method="post">
        <p class="mb-6 text-slate-600 dark:text-slate-300">לבטל את ההרשמה לעדכונים של מקראות?</p>
        <button
          type="submit"
          class="cursor-pointer rounded-xl bg-brand-strong px-6 py-2.5 font-bold text-white shadow-xs transition-all hover:bg-brand-deep"
        >
          כן, לבטל את ההרשמה
        </button>
      </form>
    )}
    {state === 'done' && (
      <p class="mb-6 text-slate-600 dark:text-slate-300">
        בוצע. לא יישלחו אליכם עוד עדכונים. אפשר להירשם שוב בכל עת, בטופס שבתחתית כל עמוד.
      </p>
    )}
    {state === 'unknown' && (
      <p class="mb-6 text-slate-600 dark:text-slate-300">
        הקישור אינו תקין. אפשר לכתוב אלינו ל־admin@mikraot.net, או להשתמש בקישור לביטול שבכל אימייל
        עדכונים.
      </p>
    )}
    <a href="/" class="text-brand-strong dark:text-brand underline">
      חזרה לדף הבית
    </a>
  </div>
</BaseLayout>
