{% highlight %}**וְ**{% /highlight %}זֹ֣את הַ{% highlight %}**בְּ**{% /highlight %}רָכָ֗ה אֲשֶׁ֨ר בֵּרַ֥ךְ מֹשֶׁ֛ה אִ֥ישׁ הָֽאֱלֹהִ֖ים אֶת־{% highlight %}**בְּ**{% /highlight %}נֵ֣י יִשְׂרָאֵ֑ל לִפְנֵ֖י מוֹתֽוֹ׃ וַיֹּאמַ֗ר יְהוָ֞ה מִסִּינַ֥י בָּא֙ {% highlight %}**וְ**{% /highlight %}זָרַ֤ח מִשֵּׂעִיר֙ לָ֔מוֹ הוֹפִ֨יעַ֙ מֵהַ֣ר פָּארָ֔ן {% highlight %}**וְ**{% /highlight %}אָתָ֖ה מֵֽרִ{% highlight %}**בְ**{% /highlight %}בֹ֣ת קֹ֑דֶשׁ מִֽימִינ֕וֹ אֵ֥שׁ דָּ֖ת לָֽמוֹ׃ אַ֚ף חֹבֵ֣ב עַמִּ֔ים כָּל־{% highlight %}**קְ**{% /highlight %}דֹשָׁ֖יו {% highlight %}**בְּ**{% /highlight %}יָדֶ֑ךָ {% highlight %}**וְ**{% /highlight %}הֵם֙ תֻּכּ֣וּ {% highlight %}**לְ**{% /highlight %}רַגְלֶ֔ךָ יִשָּׂ֖א מִדַּ{% highlight %}**בְּ**{% /highlight %}רֹתֶֽיךָ׃ תּוֹרָ֥ה צִוָּה־לָ֖נוּ מֹשֶׁ֑ה מֽוֹרָשָׁ֖ה {% highlight %}**קְ**{% /highlight %}הִלַּ֥ת יַֽעֲקֹֽב׃ וַיְהִ֥י בִֽישֻׁר֖וּן מֶ֑לֶךְ {% highlight %}**בְּ**{% /highlight %}הִתְאַסֵּף֙ רָ֣אשֵׁי עָ֔ם יַ֖חַד שִׁבְטֵ֥י יִשְׂרָאֵֽל׃ {% highlight %}**יְ**{% /highlight %}חִ֥י {% highlight %}**רְ**{% /highlight %}אוּבֵ֖ן {% highlight %}**וְ**{% /highlight %}אַל־יָמֹ֑ת וִיהִ֥י {% highlight %}**מְ**{% /highlight %}תָ֖יו מִסְפָּֽר׃ {% highlight %}**וְ**{% /highlight %}זֹ֣את לִֽיהוּדָה֮ וַיֹּאמַר֒ {% highlight %}**שְׁ**{% /highlight %}מַ֤ע יְהוָה֙ ק֣וֹל יְהוּדָ֔ה {% highlight %}**וְ**{% /highlight %}אֶל־עַמּ֖וֹ {% highlight %}**תְּ**{% /highlight %}בִיאֶ֑נּוּ יָדָיו֙ רָ֣ב ל֔וֹ {% highlight %}**וְ**{% /highlight %}עֵ֥זֶר מִצָּרָ֖יו תִּֽהְיֶֽה׃ וּ{% highlight %}**לְ**{% /highlight %}לֵוִ֣י אָמַ֔ר תֻּמֶּ֥יךָ {% highlight %}**וְ**{% /highlight %}אוּרֶ֖יךָ {% highlight %}**לְ**{% /highlight %}אִ֣ישׁ חֲסִידֶ֑ךָ אֲשֶׁ֤ר נִסִּיתוֹ֙ {% highlight %}**בְּ**{% /highlight %}מַסָּ֔ה {% highlight %}**תְּ**{% /highlight %}רִיבֵ֖הוּ עַל־מֵ֥י {% highlight %}**מְ**{% /highlight %}רִיבָֽה׃ הָֽאֹמֵ֞ר {% highlight %}**לְ**{% /highlight %}אָבִ֤יו וּלְאִמּוֹ֙ לֹ֣א {% highlight %}**רְ**{% /highlight %}אִיתִ֔יו {% highlight %}**וְ**{% /highlight %}אֶת־אֶחָיו֙ לֹ֣א הִכִּ֔יר {% highlight %}**וְ**{% /highlight %}אֶת־בָּנָ֖ו לֹ֣א יָדָ֑ע כִּ֤י שָֽׁ{% highlight %}**מְ**{% /highlight %}רוּ֙ אִמְרָתֶ֔ךָ וּבְרִֽי{% highlight %}**תְ**{% /highlight %}ךָ֖ יִנְצֹֽרוּ׃ יוֹר֤וּ מִשְׁפָּטֶ֨יךָ֙ {% highlight %}**לְ**{% /highlight %}יַֽעֲקֹ֔ב וְתוֹרָֽ{% highlight %}**תְ**{% /highlight %}ךָ֖ {% highlight %}**לְ**{% /highlight %}יִשְׂרָאֵ֑ל יָשִׂ֤ימוּ {% highlight %}**קְ**{% /highlight %}טוֹרָה֙ {% highlight %}**בְּ**{% /highlight %}אַפֶּ֔ךָ {% highlight %}**וְ**{% /highlight %}כָלִ֖יל עַֽל־מִזְ{% highlight %}**בְּ**{% /highlight %}חֶֽךָ׃ בָּרֵ֤ךְ יְהוָה֙ חֵיל֔וֹ וּפֹ֥עַל יָדָ֖יו תִּרְצֶ֑ה {% highlight %}**מְ**{% /highlight %}חַ֨ץ מָתְנַ֧יִם קָמָ֛יו וּמְשַׂנְאָ֖יו מִן־{% highlight %}**יְ**{% /highlight %}קוּמֽוּן׃ לְבִנְיָמִ֣ן אָמַ֔ר {% highlight %}**יְ**{% /highlight %}דִ֣יד יְהוָ֔ה יִשְׁכֹּ֥ן לָבֶ֖טַח עָלָ֑יו חֹפֵ֤ף עָלָיו֙ כָּל־הַיּ֔וֹם וּבֵ֥ין {% highlight %}**כְּ**{% /highlight %}תֵפָ֖יו שָׁכֵֽן׃ וּלְיוֹסֵ֣ף אָמַ֔ר {% highlight %}**מְ**{% /highlight %}בֹרֶ֥כֶת יְהוָ֖ה אַרְצ֑וֹ מִמֶּ֤גֶד שָׁמַ֨יִם֙ מִטָּ֔ל וּמִ{% highlight %}**תְּ**{% /highlight %}ה֖וֹם רֹבֶ֥צֶת תָּֽחַת׃ וּמִמֶּ֖גֶד {% highlight %}**תְּ**{% /highlight %}בוּאֹ֣ת שָׁ֑מֶשׁ וּמִמֶּ֖גֶד גֶּ֥רֶשׁ {% highlight %}**יְ**{% /highlight %}רָחִֽים׃ וּמֵרֹ֖אשׁ הַ{% highlight %}**רְ**{% /highlight %}רֵי־קֶ֑דֶם וּמִמֶּ֖גֶד גִּבְע֥וֹת עוֹלָֽם׃ וּמִמֶּ֗גֶד אֶ֚רֶץ וּמְלֹאָ֔הּ וּרְצ֥וֹן שֹֽׁ{% highlight %}**כְ**{% /highlight %}נִ֖י {% highlight %}**סְ**{% /highlight %}נֶ֑ה תָּב֨וֹאתָה֙ {% highlight %}**לְ**{% /highlight %}רֹ֣אשׁ יוֹסֵ֔ף וּלְקָדְקֹ֖ד {% highlight %}**נְ**{% /highlight %}זִ֥יר אֶחָֽיו׃ {% highlight %}**בְּ**{% /highlight %}כ֨וֹר שׁוֹר֜וֹ הָדָ֣ר ל֗וֹ {% highlight %}**וְ**{% /highlight %}קַרְנֵ֤י {% highlight %}**רְ**{% /highlight %}אֵם֙ קַרְנָ֔יו בָּהֶ֗ם עַמִּ֛ים {% highlight %}**יְ**{% /highlight %}נַגַּ֥ח יַחְדָּ֖ו אַפְסֵי־אָ֑רֶץ {% highlight %}**וְ**{% /highlight %}הֵם֙ רִ{% highlight %}**בְ**{% /highlight %}ב֣וֹת אֶפְרַ֔יִם {% highlight %}**וְ**{% /highlight %}הֵ֖ם אַלְפֵ֥י {% highlight %}**מְ**{% /highlight %}נַשֶּֽׁה׃
