{% muted %}מֵרְכָ֥א תְּבִ֛יר{% /muted %} וְרָחַ֥ץ בַּמַּ֛יִם

{% muted %}טִפְּחָ֖א {% /muted %}אֶת־בְּשָׂר֖וֹ

{% muted %}סוֹף-פָּסֽוּק:{% /muted %} וּלְבֵשָֽׁם׃

## תרגול 2 – פסוקים

{% muted %}רְבִיעִ֗י{% /muted %} וּמֵאֵ֗ת {% muted %}פַּשְׁטָא֙{% /muted %} עֲדַת֙ {% muted %}מוּנַ֣ח זָקֵף-קָטֹ֔ן{% /muted %} בְּנֵ֣י יִשְׂרָאֵ֔ל {% muted %}תְּבִ֛יר{% /muted %} יִקַּ֛ח {% muted %}מֵרְכָ֥א טִפְּחָ֖א{% /muted %} שְׁנֵֽי־שְׂעִירֵ֥י עִזִּ֖ים {% muted %}אֶתְנַחְתָּ֑א {% /muted %}לְחַטָּ֑את {% muted %}מֵרְכָ֥א טִפְּחָ֖א{% /muted %} וְאַ֥יִל אֶחָ֖ד {% muted %}סוֹף-פָּסֽוּק:{% /muted %} לְעֹלָֽה׃

{% muted %}דַּרְגָּ֧א תְּבִ֛יר{% /muted %} וְהִקְרִ֧יב אַהֲרֹ֛ן {% muted %}מֵרְכָ֥א טִפְּחָ֖א{% /muted %} אֶת־פַּ֥ר הַחַטָּ֖את {% muted %}אֶתְנַחְתָּ֑א {% /muted %}אֲשֶׁר־ל֑וֹ {% muted %}מֵרְכָ֥א טִפְּחָ֖א{% /muted %} וְכִפֶּ֥ר בַּעֲד֖וֹ {% muted %}מֵרְכָ֥א סוֹף-פָּסֽוּק:{% /muted %} וּבְעַ֥ד בֵּיתֽוֹ׃

{% muted %}טִפְּחָ֖א{% /muted %} וְלָקַ֖ח {% muted %}מוּנַ֣ח{% /muted %} {% muted %}אֶתְנַחְתָּ֑א{% /muted %} אֶת־שְׁנֵ֣י הַשְּׂעִירִ֑ם {% muted %}מַהְפַּ֤ך פַּשְׁטָא֙{% /muted %} וְהֶעֱמִ֤יד אֹתָם֙ {% muted %}מוּנַ֣ח זָקֵף-קָטֹ֔ן{% /muted %} לִפְנֵ֣י יְהֹוָ֔ה {% muted %}טִפְּחָ֖א{% /muted %} פֶּ֖תַח {% muted %}מֵרְכָ֥א{% /muted %} {% muted %}סוֹף-פָּסֽוּק:{% /muted %} אֹ֥הֶל מוֹעֵֽד׃

{% muted %}דַּרְגָּ֧א תְּבִ֛יר{% /muted %} וְנָתַ֧ן אַהֲרֹ֛ן {% muted %}מֵרְכָ֥א טִפְּחָ֖א{% /muted %} עַל־שְׁנֵ֥י הַשְּׂעִירִ֖ם {% muted %}אֶתְנַחְתָּ֑א {% /muted %}גֹּרָל֑וֹת {% muted %}מַהְפַּ֤ך פַּשְׁטָא֙{% /muted %} גּוֹרָ֤ל אֶחָד֙ {% muted %}זָקֵף-קָטֹ֔ן{% /muted %} לַיהֹוָ֔ה {% muted %}מֵרְכָ֥א טִפְּחָ֖א{% /muted %} וְגוֹרָ֥ל אֶחָ֖ד {% muted %}סוֹף-פָּסֽוּק:{% /muted %} לַעֲזָאזֵֽל׃

{% muted %}מַהפַּ֤ך פַּשְׁטָא֙{% /muted %} וְהִקְרִ֤יב אַהֲרֹן֙ {% muted %}זָקֵף-קָטֹ֔ן{% /muted %} אֶת־הַשָּׂעִ֔יר {% muted %}קַדְמָ֨א{% /muted %} אֲשֶׁ֨ר {% muted %}{% muted %}מֵרְכָ֥א {% /muted %}תְּבִ֛יר{% /muted %} עָלָ֥ה עָלָ֛יו {% muted %}טִפְּחָ֖א{% /muted %} הַגּוֹרָ֖ל {% muted %}אֶתְנַחְתָּ֑א{% /muted %} לַיהֹוָ֑ה {% muted %}טִפְּחָ֖א{% /muted %} וְעָשָׂ֖הוּ {% muted %}סוֹף-פָּסֽוּק:{% /muted %} חַטָּֽאת׃

{% muted %}רְבִיעִ֗י {% /muted %}וְהַשָּׂעִ֗יר {% muted %}תְּלִישָׁא-קְטַנָּה֩{% /muted %}&nbsp;אֲשֶׁר֩ {% muted %}קַדְמָ֨א {% /muted %}עָלָ֨ה {% muted %}מַהְפַּ֤ך פַּשְׁטָא֙{% /muted %} עָלָ֤יו הַגּוֹרָל֙ {% muted %}זָקֵף-קָטֹ֔ן{% /muted %} לַעֲזָאזֵ֔ל {% muted %}תְּבִ֛יר{% /muted %} יׇֽעֳמַד־חַ֛י {% muted %}מֵרְכָ֥א טִפְּחָ֖א{% /muted %} לִפְנֵ֥י יְהֹוָ֖ה {% muted %}מוּנַ֣ח{% /muted %} {% muted %}אֶתְנַחְתָּ֑א {% /muted %}לְכַפֵּ֣ר עָלָ֑יו {% muted %}{% muted %}מֵרְכָ֥א {% /muted %}תְּבִ֛יר{% /muted %} לְשַׁלַּ֥ח אֹת֛וֹ {% muted %}טִפְּחָ֖א{% /muted %} לַעֲזָאזֵ֖ל {% muted %}סוֹף-פָּסֽוּק:{% /muted %} הַמִּדְבָּֽרָה׃

{% muted %}קַדְמָ֨א ואַזְלָ֜א{% /muted %} וְהִקְרִ֨יב אַהֲרֹ֜ן {% muted %}מַהְפַּ֤ך פַּשְׁטָא֙{% /muted %} אֶת־פַּ֤ר הַֽחַטָּאת֙ {% muted %}זָקֵף-קָטֹ֔ן{% /muted %} אֲשֶׁר־ל֔וֹ {% muted %}מֵרְכָ֥א טִפְּחָ֖א{% /muted %} וְכִפֶּ֥ר בַּֽעֲד֖וֹ {% muted %}מוּנַ֣ח{% /muted %} {% muted %}אֶתְנַחְתָּ֑א {% /muted %} וּבְעַ֣ד בֵּית֑וֹ {% muted %}תְּבִ֛יר{% /muted %} וְשָׁחַ֛ט {% muted %}מֵרְכָ֥א טִפְּחָ֖א{% /muted %} אֶת־פַּ֥ר הַֽחַטָּ֖את {% muted %}סוֹף-פָּסֽוּק:{% /muted %} אֲשֶׁר־לֽוֹ׃

{% muted %}מוּנַ֣ח תְּ֠לִישָא-גְדוֹלָ֠ה {% /muted %}וְלָקַ֣ח מְלֹֽא־הַ֠מַּחְתָּ֠ה {% muted %}גֵּרְשַׁ֞יִם&nbsp;{% /muted %}גַּֽחֲלֵי־אֵ֞שׁ {% muted %}מַהְפַּ֤ך שְׁנֵי-פַּ֨שְׁטִין֙ {% /muted %}מֵעַ֤ל הַמִּזְבֵּ֙חַ֙ {% muted %}מוּנַ֣ח זָקֵף-קָטֹ֔ן{% /muted %} מִלִּפְנֵ֣י יְהֹוָ֔ה {% muted %}מוּנַ֣ח זָקֵף-קָטֹ֔ן{% /muted %} וּמְלֹ֣א חׇפְנָ֔יו {% muted %}מֵרְכָ֥א טִפְּחָ֖א{% /muted %} קְטֹ֥רֶת סַמִּ֖ים {% muted %}אֶתְנַחְתָּ֑א{% /muted %} דַּקָּ֑ה {% muted %}טִפְּחָ֖א{% /muted %} וְהֵבִ֖יא {% muted %}מֵרְכָ֥א סוֹף-פָּסֽוּק:{% /muted %} מִבֵּ֥ית לַפָּרֹֽכֶת׃

{% muted %}דַּרְגָּ֧א תְּבִ֛יר{% /muted %} וְנָתַ֧ן אֶֽת־הַקְּטֹ֛רֶת {% muted %}טִפְּחָ֖א{% /muted %} עַל־הָאֵ֖שׁ {% muted %}מוּנַ֣ח {% /muted %} {% muted %}אֶתְנַחְתָּ֑א {% /muted %}לִפְנֵ֣י יְהֹוָ֑ה {% muted %}מוּנַ֣ח-לְגַרְמֵ֣הּ׀ {% /muted %}וְכִסָּ֣ה **׀**&nbsp; {% muted %}מוּנַ֣ח רְבִיעִ֗י {% /muted %}עֲנַ֣ן הַקְּטֹ֗רֶת {% muted %}תְּבִ֛יר{% /muted %} אֶת־הַכַּפֹּ֛רֶת {% muted %}מֵרְכָ֥א טִפְּחָ֖א{% /muted %} אֲשֶׁ֥ר עַל־הָעֵד֖וּת {% muted %}מֵרְכָ֥א {% /muted %} {% muted %}סוֹף-פָּסֽוּק:{% /muted %} וְלֹ֥א יָמֽוּת׃
