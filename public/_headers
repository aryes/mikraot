# Security headers for every static response (Cloudflare Workers static assets); the Worker adds
# the same to its own answers (src/server/security-headers.ts, which a test keeps in step).
# The Content-Security-Policy for scripts, styles and frames is a <meta> in each page (astro.config.mjs);
# this header adds what a <meta> cannot: frame-ancestors (no embedding of the site elsewhere).
# HSTS deliberately without includeSubDomains: mail. and ftp. are not served over HTTPS via Cloudflare.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/feed/*
  Content-Type: application/rss+xml; charset=utf-8
/category/:slug/feed/*
  Content-Type: application/rss+xml; charset=utf-8
/%D7%9E%D7%94-%D7%97%D7%93%D7%A9/feed/*
  Content-Type: application/rss+xml; charset=utf-8
/sitemap.rss
  Content-Type: application/rss+xml; charset=utf-8
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# Pagefind's index pieces have content-hashed names: a new build gets new names (its unhashed
# pagefind.js and pagefind-entry.json keep the default, revalidated each time).
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable
