{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // One Worker serves the static pages (assets) and the /api routes.
  "name": "mikraot",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve src/pages/404.astro (with status 404) for unknown URLs.
    "not_found_handling": "404-page",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mikraot-db",
      "database_id": "2ec94a3f-c042-4c21-b1fb-e25f69941888",
    },
  ],
  // Comment posting: at most 5 per minute from one IP address (spam and abuse).
  "ratelimits": [
    {
      "name": "COMMENT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "observability": { "enabled": true },
}
