{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // One Worker serves the static pages (assets) and the /api routes.
  "name": "mikraot",
  // Astro's handler plus the daily backup (src/worker.ts).
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  // The switch (docs/CUTOVER.md, step 2): this Worker serves mikraot.net. workers.dev goes away;
  // branch previews stay.
  "routes": [{ "pattern": "mikraot.net/*", "zone_name": "mikraot.net" }],
  "workers_dev": false,
  // The Brevo newsletter list sign-ups join (src/server/newsletter.ts); previews have their own.
  "vars": { "NEWSLETTER_LIST_ID": "4" },
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve src/pages/404.astro (with status 404) for unknown URLs.
    "not_found_handling": "404-page",
    // The addresses the Worker answers (pages and API routes with `prerender = false`): without
    // this, a browser opening one (a navigation) got the 404 page instead of the Worker's answer.
    // Keep in step with those routes (src/routes.test.ts checks it).
    "run_worker_first": [
      "/api/*",
      "/unsubscribe/*",
      "/newsletter/unsubscribe/*",
      "/comments/feed/*",
      "/comments/manage/*",
      // Recordings, answered in pieces (src/server/audio-range.ts).
      "/wp-content/uploads/*.mp3",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mikraot-db",
      "database_id": "2ec94a3f-c042-4c21-b1fb-e25f69941888",
    },
  ],
  // Comment posting: at most 5 per minute from one IP address (spam and abuse).
  "ratelimits": [
    {
      "name": "COMMENT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    // Owner alert emails: about one a minute per kind in each Cloudflare location (counted locally
    // and roughly), before the hourly KV throttle
    // (src/server/alerts.ts), so a burst of failures can't send a burst of emails.
    {
      "name": "ALERT_RATE_LIMIT",
      "namespace_id": "1009",
      "simple": { "limit": 1, "period": 60 },
    },
    // Newsletter sign-ups: each sends an email, so at most 3 per minute from one visitor.
    {
      "name": "NEWSLETTER_RATE_LIMIT",
      "namespace_id": "1011",
      "simple": { "limit": 3, "period": 60 },
    },
    // ...and one confirmation email a minute to any one address.
    {
      "name": "NEWSLETTER_EMAIL_RATE_LIMIT",
      "namespace_id": "1013",
      "simple": { "limit": 1, "period": 60 },
    },
    // Searches that found nothing: at most 20 reports per minute from one visitor.
    {
      "name": "SEARCH_RATE_LIMIT",
      "namespace_id": "1005",
      "simple": { "limit": 20, "period": 60 },
    },
    // Quiz duels: at most 10 room connections a minute from one visitor (src/server/duel-route.ts).
    {
      "name": "DUEL_RATE_LIMIT",
      "namespace_id": "1015",
      "simple": { "limit": 10, "period": 60 },
    },
    // Sign-in links (src/server/auth-route.ts): each sends an email, so at most 5 a minute from one
    // visitor...
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "1017",
      "simple": { "limit": 5, "period": 60 },
    },
    // ...and one a minute to any one address.
    {
      "name": "AUTH_EMAIL_RATE_LIMIT",
      "namespace_id": "1019",
      "simple": { "limit": 1, "period": 60 },
    },
    // Any sign-in request (checking who is signed in, signing out, Google): 30 a minute.
    {
      "name": "AUTH_API_RATE_LIMIT",
      "namespace_id": "1021",
      "simple": { "limit": 30, "period": 60 },
    },
    // Quiz results sent by one account (src/pages/api/quiz-results.ts): each may rewrite a row per
    // quiz, so 10 a minute, whatever addresses they come from.
    {
      "name": "QUIZ_SYNC_RATE_LIMIT",
      "namespace_id": "1023",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // Quiz duels (src/server/quiz-duel.ts): one Durable Object per room, kept in its own SQLite
  // storage (the only kind the free plan has); a room deletes itself after 3 hours.
  "durable_objects": { "bindings": [{ "name": "QUIZ_DUEL", "class_name": "QuizDuel" }] },
  "migrations": [{ "tag": "v1-quiz-duel", "new_sqlite_classes": ["QuizDuel"] }],
  // Searches that found nothing (src/server/search-misses.ts): Analytics Engine keeps 3 months.
  "analytics_engine_datasets": [{ "binding": "SEARCH_MISSES", "dataset": "mikraot_search_misses" }],
  // Daily database backup (src/server/backup.ts), at 02:17 UTC, a quiet hour.
  "triggers": { "crons": ["17 2 * * *"] },
  // Emails Brevo refused wait here and are sent again by the Worker's `queue` handler every hour
  // for a day (src/server/email.ts). Free plan: messages kept 24 hours.
  "queues": {
    "producers": [{ "binding": "EMAIL_RETRY", "queue": "mikraot-email-retry" }],
    "consumers": [
      {
        "queue": "mikraot-email-retry",
        "max_batch_size": 10,
        "max_retries": 23, // above the code's own limit (src/server/email.ts MAX_ATTEMPTS)
        "retry_delay": 3600,
      },
    ],
  },
  "kv_namespaces": [
    { "binding": "BACKUPS", "id": "74ecb19e9d864308bd5f9b0add3e2c11" },
    // When each kind of failure was last emailed, so an outage sends one email an hour.
    { "binding": "ALERTS", "id": "1d520101c5964450b319f01663e8b890" },
  ],
  "observability": { "enabled": true },
  // Worker Previews (one per git branch, `wrangler preview`): they behave as the site does (Arye,
  // 2026-11-21), with their own database and rate-limit counters, so test data never reaches
  // production. Their secrets are the Preview base config's (docs/OPERATIONS.md, Previews).
  "previews": {
    // Brevo list "previews": a test sign-up never joins the newsletter.
    "vars": { "NEWSLETTER_LIST_ID": "5" },
    // Each preview gets its own rooms (Cloudflare isolates a preview's Durable Objects); the
    // binding must be repeated here, or a preview has none.
    "durable_objects": { "bindings": [{ "name": "QUIZ_DUEL", "class_name": "QuizDuel" }] },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "mikraot-db-preview",
        "database_id": "8e22a15a-bb5d-467c-8ca6-1d0b65f0e468",
      },
    ],
    "analytics_engine_datasets": [
      { "binding": "SEARCH_MISSES", "dataset": "mikraot_search_misses_preview" },
    ],
    "kv_namespaces": [
      { "binding": "BACKUPS", "id": "e39f0a30655c44d9881659e82e0b9ee6" },
      { "binding": "ALERTS", "id": "76d137f506a047fd9adabd9bb52d65c6" },
    ],
    "ratelimits": [
      {
        "name": "COMMENT_RATE_LIMIT",
        "namespace_id": "1002",
        "simple": { "limit": 5, "period": 60 },
      },
      {
        "name": "ALERT_RATE_LIMIT",
        "namespace_id": "1010",
        "simple": { "limit": 1, "period": 60 },
      },
      {
        "name": "NEWSLETTER_RATE_LIMIT",
        "namespace_id": "1012",
        "simple": { "limit": 3, "period": 60 },
      },
      {
        "name": "NEWSLETTER_EMAIL_RATE_LIMIT",
        "namespace_id": "1014",
        "simple": { "limit": 1, "period": 60 },
      },
      {
        "name": "SEARCH_RATE_LIMIT",
        "namespace_id": "1006",
        "simple": { "limit": 20, "period": 60 },
      },
      {
        "name": "DUEL_RATE_LIMIT",
        "namespace_id": "1016",
        "simple": { "limit": 10, "period": 60 },
      },
      {
        "name": "AUTH_RATE_LIMIT",
        "namespace_id": "1018",
        "simple": { "limit": 5, "period": 60 },
      },
      {
        "name": "AUTH_EMAIL_RATE_LIMIT",
        "namespace_id": "1020",
        "simple": { "limit": 1, "period": 60 },
      },
      {
        "name": "AUTH_API_RATE_LIMIT",
        "namespace_id": "1022",
        "simple": { "limit": 30, "period": 60 },
      },
      {
        "name": "QUIZ_SYNC_RATE_LIMIT",
        "namespace_id": "1024",
        "simple": { "limit": 10, "period": 60 },
      },
    ],
  },
}
