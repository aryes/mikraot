{
  "name": "mikraot-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run db:dev:reset && astro dev",
    "cms": "astro dev --config astro.config.cms.mjs --port 4400",
    "check": "astro check && oxlint --type-aware --deny-warnings && prettier --check . && vitest run",
    "build": "astro check && npm run build:site",
    "build:site": "astro build && html-validate dist/client && pagefind --site dist/client",
    "preview": "astro preview",
    "deploy:dry": "wrangler deploy --dry-run",
    "typecheck": "astro check",
    "lint": "oxlint --type-aware",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "compare:live": "tsx scripts/compare-with-live.ts",
    "check:links": "tsx scripts/check-external-links.ts",
    "check:urls": "tsx scripts/check-url-parity.ts",
    "seo:fetch": "tsx scripts/content/fetch-live-seo.ts",
    "content:import": "tsx scripts/content/import-wordpress.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:local:reset": "wrangler d1 migrations apply mikraot-db --local && wrangler d1 execute mikraot-db --local --file e2e/fixtures/comments.sql",
    "cf-typegen": "wrangler types",
    "prepare": "git config core.hooksPath .githooks",
    "test:deployed": "tsx scripts/test-deployed.ts",
    "search:misses": "tsx scripts/search-misses.ts",
    "lighthouse": "lhci autorun",
    "db:dev:reset": "wrangler d1 migrations apply mikraot-db --local --persist-to .wrangler/state-dev && wrangler d1 execute mikraot-db --local --persist-to .wrangler/state-dev --file e2e/fixtures/comments.sql"
  },
  "dependencies": {
    "@astrojs/markdoc": "^2.0.9",
    "@astrojs/react": "^7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/noto-sans-hebrew": "^5.3.0",
    "@fontsource-variable/noto-serif-hebrew": "^5.3.0",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "astro": "^7.3.5",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/node": "^11.1.6",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@markdoc/markdoc": "^0.5.10",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "html-validate": "^11.16.2",
    "linkedom": "^0.18.13",
    "linkinator": "^8.1.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "schema-dts": "^2.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260930.2": true
  }
}
